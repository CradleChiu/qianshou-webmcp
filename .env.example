# TDX 會員中心提供的 server-side API 金鑰
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 中央氣象署開放資料平臺授權碼
CWA_API_KEY=

# OpenTripPlanner 2.9 GTFS GraphQL endpoint（預設值如下）
OTP_GRAPHQL_URL=http://127.0.0.1:8080/otp/gtfs/v1
OTP_TIMEOUT_MS=20000

# 選填：若另行取得雙北現行公車 GTFS 下載 URL，供 infra/otp/fetch-data.ps1 使用
TDX_GTFS_TAIPEI_BUS_URL=
TDX_GTFS_NEWTAIPEI_BUS_URL=

# 選填：上游逾時，允許 1000–10000 毫秒
UPSTREAM_TIMEOUT_MS=5000

# 選填：測試或代理環境才需要覆寫
# TDX_TOKEN_URL=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
# TDX_API_BASE_URL=https://tdx.transportdata.tw/api/basic
# CWA_API_BASE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore

# TDX 會員中心提供的 server-side API 金鑰
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# 中央氣象署開放資料平臺授權碼
CWA_API_KEY=

# Codex CLI 自然語言行程需求服務；正式版與 Next.js 同機時維持 loopback
INTENT_SERVICE_URL=http://127.0.0.1:8020/v1/interpret
INTENT_SERVICE_TIMEOUT_MS=65000

# 匿名工作階段事件資料庫；正式環境應放在 release 目錄之外
# ANALYTICS_DB_PATH=/srv/qianshou/shared/analytics.sqlite
# 事件自動保存天數（1–365）
ANALYTICS_RETENTION_DAYS=30

# 部署在現有網域子路徑時使用；本機開發留空
# NEXT_PUBLIC_BASE_PATH=/journey

# OpenTripPlanner 2.9 GTFS GraphQL endpoint（預設值如下）
OTP_GRAPHQL_URL=http://127.0.0.1:8080/otp/gtfs/v1
OTP_TIMEOUT_MS=20000

# 選填：覆寫 TDX 全臺靜態 GTFS 端點；預設已使用官方 V3 端點
# TDX_GTFS_NATIONAL_URL=https://tdx.transportdata.tw/api/gtfs/V3/Map/GTFS/Static

# 選填：上游逾時，允許 1000–10000 毫秒
UPSTREAM_TIMEOUT_MS=5000

# 選填：地點搜尋服務。公共 Nominatim 僅適合目前的低流量、使用者主動查詢試行版
# NOMINATIM_SEARCH_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
# NOMINATIM_USER_AGENT=Qianshou-Guolu-Zou/0.1 (contact: you@example.com)

# 選填：測試或代理環境才需要覆寫
# TDX_TOKEN_URL=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
# TDX_API_BASE_URL=https://tdx.transportdata.tw/api/basic
# CWA_API_BASE_URL=https://opendata.cwa.gov.tw/api/v1/rest/datastore
